# PeachtreesCMS API Environment Configuration
#
# Default values are built-in config.php, this file is an optional override configuration.
# Runs fine without .env (for development / quick trial).
#
# When deploying to production, it is recommended to create .env to override default values:
#   1. Copy:  cp .env.example .env
#   2. Edit:  Fill in actual database connection info and JWT secret
#   3. Ensure: .env is not committed to version control
#
# Shared hosting security tip:
#   config.php will automatically search upwards for .env files in parent directories (up to 3 levels).
#   If you use shared hosting (unable to configure nginx), it is recommended to place .env outside the web root,
#   such as the parent directory of public_html/, so that browsers cannot access it directly:
#
#     /home/your_user/
#     ├── .env                    ← Place here (secure)
#     └── public_html/
#         └── blog/
#             ├── index.html
#             └── pt_api/
#
# Default values (used when .env is not created):
#   DB_HOST=localhost  DB_NAME=peachtrees  DB_USER=root  DB_PASS=(empty)
#   JWT_SECRET=dev-only-insecure-key-CHANGE-ME (⚠️ Must change in production)

# Database configuration
DB_HOST=localhost
DB_NAME=peachtrees
DB_USER=root
DB_PASS=your_database_password

# JWT secret (must be changed to a strong random string)
JWT_SECRET=your_strong_random_secret_key_here

# Path overrides (all optional — uncomment and fill for custom deployment)
# Default: auto-detected relative to project root
# UPLOAD_DIR=/var/www/html/blog/upload
# THEME_DIR=/var/www/html/blog/theme
# STYLE_DIR=/var/www/html/blog/pattern
