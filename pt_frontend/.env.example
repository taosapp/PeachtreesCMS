# PeachtreesCMS Frontend - Development Environment Variables Example
#
# If your local development folder name is NOT "PeachtreesCMS" (e.g., your local URL is http://localhost/my-blog/pt_api/),
# you can copy this file to `.env.local` or `.env.development` and change the value below.
#
# Default (when no env files exist): /PeachtreesCMS/pt_api/
#
VITE_API_BASE_URL=/PeachtreesCMS/pt_api/
